# Secrets for `supabase functions serve send-share-email --env-file .env.local`
#
# Copy to .env.local and fill in. That file is git-ignored; this one is not, and
# must never contain real values.
#
# Set the same values on the hosted project with:
#   supabase secrets set RESEND_API_KEY=... --project-ref ofpbdzqnszupgtjkncgv

# Required. From resend.com → API Keys.
RESEND_API_KEY=re_your_key_here

# The From header. Resend's default address can only send to your own inbox
# until you verify a domain.
MAIL_FROM=Map204 <onboarding@resend.dev>

# The link the email points at. Override on preview deployments so a test share
# cannot send somebody to production.
APP_URL=https://map204.vercel.app
